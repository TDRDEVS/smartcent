<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fill color -->
    <solid android:background="#B46A02"/>

    <!-- Border -->
    <stroke android:width="2dp" android:color="#000000"/>

    <!-- Rounded corners -->
    <corners android:radius="16dp"/>

    <!-- Padding inside -->
    <padding
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp"/>
</shape>
