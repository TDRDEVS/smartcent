<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Title -->
    <TextView
        android:id="@+id/achievementsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="My Achievements"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Empty state message -->
    <TextView
        android:id="@+id/emptyMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No achievements unlocked yet. Start exploring features to earn badges!"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Section heading -->
    <TextView
        android:id="@+id/achievementsSectionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Unlocked Badges"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <!-- Scrollable badge list -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/achievementsList"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Placeholder text ensures accessibility -->
            <TextView
                android:id="@+id/placeholderText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your achievements will appear here"
                android:textSize="16sp"
                android:gravity="center"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
